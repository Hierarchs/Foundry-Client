{
  "name": "foundry-client",
  "version": "0.1.0",
  "description": "A focused, GPU-accelerated desktop client for Foundry Virtual Tabletop and Sqyre hosting.",
  "author": "Hierarchs",
  "private": true,
  "main": "src/main.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "playwright test",
    "test:packaged": "node scripts/smoke-packaged.cjs",
    "check": "node scripts/check.cjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis portable",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.hierarchs.foundryclient",
    "productName": "Foundry Client",
    "artifactName": "Foundry-Client-${version}-${arch}-${os}.${ext}",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/ui/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "artifactName": "Foundry-Client-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
