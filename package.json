{
  "name": "foundry-client",
  "version": "0.5.0",
  "description": "Native Rust and WebView2 desktop client for Foundry Virtual Tabletop V14 and Sqyre hosting.",
  "author": "Hierarchs",
  "private": true,
  "main": "src/main.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node scripts/rust.cjs run --manifest-path native/Cargo.toml --locked",
    "start:electron": "electron .",
    "build": "node scripts/rust.cjs build --manifest-path native/Cargo.toml --release --locked",
    "test:rust": "node scripts/rust.cjs test --manifest-path native/Cargo.toml --locked",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "node scripts/test-native-runner.cjs",
    "test:electron": "playwright test",
    "benchmark": "node scripts/benchmark-hosts.cjs",
    "test:packaged:electron": "node scripts/smoke-packaged.cjs",
    "check": "node scripts/check.cjs",
    "pack": "node scripts/rust.cjs build --manifest-path native/Cargo.toml --release --locked",
    "pack:electron": "electron-builder --dir",
    "dist": "node scripts/package-native.cjs",
    "dist:electron": "electron-builder --win nsis portable",
    "dist:portable": "node scripts/package-native.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.hierarchs.foundryclient",
    "productName": "Foundry Client",
    "artifactName": "Foundry-Client-${version}-${arch}-${os}.${ext}",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/ui/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "artifactName": "Foundry-Client-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
